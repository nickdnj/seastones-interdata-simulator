{
  "schema": "seastones.patch/1",
  "slug": "bell",
  "map": "all-da-4",
  "auth": "authentic",
  "program": {
    "routine": "play"
  },
  "templates": {
    "voice": {
      "modules": [
        {
          "id": "car",
          "type": "vco",
          "params": {
            "fm": 250.0
          }
        },
        {
          "id": "modo",
          "type": "vco",
          "params": {
            "tune": 1.4647
          }
        },
        {
          "id": "fmeg",
          "type": "env",
          "params": {
            "attack": 0.001,
            "decay": 0.6,
            "sustain": 0.0,
            "release": 0.6
          }
        },
        {
          "id": "fmamp",
          "type": "vca"
        },
        {
          "id": "eg",
          "type": "env",
          "params": {
            "attack": 0.001,
            "decay": 3.0,
            "sustain": 0.0,
            "release": 3.0
          }
        },
        {
          "id": "amp",
          "type": "vca"
        }
      ],
      "cables": [
        [
          "$pitch",
          "car.pitch"
        ],
        [
          "$pitch",
          "modo.pitch"
        ],
        [
          "$gate",
          "fmeg.gate"
        ],
        [
          "$gate",
          "eg.gate"
        ],
        [
          "modo.sine",
          "fmamp.in"
        ],
        [
          "fmeg.out",
          "fmamp.cv"
        ],
        [
          "fmamp.out",
          "car.fm"
        ],
        [
          "car.sine",
          "amp.in"
        ],
        [
          "eg.out",
          "amp.cv"
        ],
        [
          "amp.out",
          "$out"
        ]
      ]
    }
  },
  "voices": {
    "template": "voice",
    "count": 4,
    "pitch": "dac.{i}",
    "gate": "dac.{i+4}",
    "out": "mix{i%2}.in{i/2+1}"
  },
  "modules": [
    {
      "id": "mix0",
      "type": "mixer",
      "params": {
        "l1": 0.3,
        "l2": 0.3
      }
    },
    {
      "id": "mix1",
      "type": "mixer",
      "params": {
        "l1": 0.3,
        "l2": 0.3
      }
    },
    {
      "id": "send",
      "type": "mixer",
      "params": {
        "l1": 0.5,
        "l2": 0.5
      }
    },
    {
      "id": "echo",
      "type": "echo",
      "params": {
        "time": 0.33,
        "feedback": 0.3,
        "mix": 1.0,
        "tone": 5000.0
      }
    },
    {
      "id": "busl",
      "type": "mixer",
      "params": {
        "l1": 1.0,
        "l2": 0.3,
        "l3": 0.45
      }
    },
    {
      "id": "busr",
      "type": "mixer",
      "params": {
        "l1": 1.0,
        "l2": 0.3,
        "l3": 0.45
      }
    },
    {
      "id": "out",
      "type": "out",
      "params": {
        "level": 0.65
      }
    }
  ],
  "cables": [
    [
      "mix0.out",
      "send.in1"
    ],
    [
      "mix1.out",
      "send.in2"
    ],
    [
      "send.out",
      "echo.in"
    ],
    [
      "mix0.out",
      "busl.in1"
    ],
    [
      "echo.l",
      "busl.in2"
    ],
    [
      "mix1.out",
      "busl.in3"
    ],
    [
      "mix1.out",
      "busr.in1"
    ],
    [
      "echo.r",
      "busr.in2"
    ],
    [
      "mix0.out",
      "busr.in3"
    ],
    [
      "busl.out",
      "out.l"
    ],
    [
      "busr.out",
      "out.r"
    ]
  ]
