{
  "format": "seastones.modules/1",
  "sources": {"dac": 16, "gate": 16, "gate_volts": 5.0},
  "modules": [
    {"type": "vco",
     "inputs": [{"name": "pitch", "unit": "V/oct"}, {"name": "mod", "unit": "V/oct"}, {"name": "fm", "unit": "V"}, {"name": "pw", "unit": "V"}],
     "outputs": [{"name": "sine", "unit": "audio"}, {"name": "tri", "unit": "audio"}, {"name": "saw", "unit": "audio"}, {"name": "pulse", "unit": "audio"}],
     "params": [{"name": "tune", "min": -5, "max": 5, "default": 0, "unit": "V"},
                 {"name": "fine", "min": -1, "max": 1, "default": 0, "unit": "semitone"},
                 {"name": "mod_amt", "min": -2, "max": 2, "default": 1, "unit": "x"},
                 {"name": "fm", "min": 0, "max": 2000, "default": 0, "unit": "Hz/V"},
                 {"name": "width", "min": 0.02, "max": 0.97999999999999998, "default": 0.5, "unit": "duty"}],
     "note": "band-limited (minBLEP/minBLAMP, ADR-010); 0 V is C0, 16.352 Hz; pulse width = width + pw/10"},
    {"type": "vcf",
     "inputs": [{"name": "in", "unit": "audio"}, {"name": "cutoff", "unit": "V/oct"}, {"name": "res", "unit": "V"}],
     "outputs": [{"name": "lp", "unit": "audio"}, {"name": "hp", "unit": "audio"}, {"name": "bp", "unit": "audio"}],
     "params": [{"name": "cutoff", "min": -2, "max": 12, "default": 7, "unit": "V"},
                 {"name": "res", "min": 0, "max": 1, "default": 0, "unit": "0-1"},
                 {"name": "track", "min": -2, "max": 2, "default": 1, "unit": "x"},
                 {"name": "res_amt", "min": 0, "max": 1, "default": 0.10000000000000001, "unit": "per V"},
                 {"name": "drive", "min": 0.25, "max": 4, "default": 1, "unit": "x"}],
     "note": "lp: 4-pole ZDF ladder, tanh input, 2x oversampled; hp, bp: 2-pole SVF; cutoff = cutoff + track x cutoff input, 0 V is 16.352 Hz"},
    {"type": "vca",
     "inputs": [{"name": "in", "unit": "audio"}, {"name": "cv", "unit": "V"}],
     "outputs": [{"name": "out", "unit": "audio"}],
     "params": [{"name": "expo", "min": 0, "max": 1, "default": 0, "unit": "0 lin, 1 exp"},
                 {"name": "bias", "min": 0, "max": 10, "default": 0, "unit": "V"}],
     "note": "gain = (bias + cv) / 10 V, after a 0.5 ms declick on the cv (ADR-005)"},
    {"type": "env",
     "inputs": [{"name": "gate", "unit": "gate"}, {"name": "retrig", "unit": "gate"}],
     "outputs": [{"name": "out", "unit": "V"}],
     "params": [{"name": "attack", "min": 0, "max": 30, "default": 0.002, "unit": "s"},
                 {"name": "decay", "min": 0, "max": 30, "default": 0.20000000000000001, "unit": "s"},
                 {"name": "sustain", "min": 0, "max": 1, "default": 0.69999999999999996, "unit": "0-1"},
                 {"name": "release", "min": 0, "max": 30, "default": 0.29999999999999999, "unit": "s"},
                 {"name": "ar", "min": 0, "max": 1, "default": 0, "unit": "0 ADSR, 1 AR"}],
     "note": "gate high above 2.5 V; out 0-10 V"},
    {"type": "lfo",
     "inputs": [{"name": "rate", "unit": "V/oct"}],
     "outputs": [{"name": "sine", "unit": "V"}, {"name": "tri", "unit": "V"}, {"name": "square", "unit": "V"}, {"name": "sh", "unit": "V"}],
     "params": [{"name": "rate", "min": -10, "max": 8, "default": 0, "unit": "V (0 V = 1 Hz)"},
                 {"name": "level", "min": 0, "max": 10, "default": 1, "unit": "V"}],
     "note": "outputs +/- level volts"},
    {"type": "noise",
     "inputs": [],
     "outputs": [{"name": "white", "unit": "audio"}, {"name": "pink", "unit": "audio"}],
     "params": [{"name": "level", "min": 0, "max": 1, "default": 1, "unit": "x"}],
     "note": "deterministic: seeded per module"},
    {"type": "slew",
     "inputs": [{"name": "in", "unit": "V"}],
     "outputs": [{"name": "out", "unit": "V"}],
     "params": [{"name": "rise", "min": 0, "max": 10, "default": 0.050000000000000003, "unit": "s"},
                 {"name": "fall", "min": 0, "max": 10, "default": 0.050000000000000003, "unit": "s"}],
     "note": "the only deliberate smoothing of a D/A step (NFR-2)"},
    {"type": "mixer",
     "inputs": [{"name": "in1", "unit": "any"}, {"name": "in2", "unit": "any"}, {"name": "in3", "unit": "any"}, {"name": "in4", "unit": "any"}],
     "outputs": [{"name": "out", "unit": "any"}],
     "params": [{"name": "l1", "min": 0, "max": 2, "default": 1, "unit": "x"},
                 {"name": "l2", "min": 0, "max": 2, "default": 1, "unit": "x"},
                 {"name": "l3", "min": 0, "max": 2, "default": 1, "unit": "x"},
                 {"name": "l4", "min": 0, "max": 2, "default": 1, "unit": "x"}],
     "note": "out = sum of level x input"},
    {"type": "echo",
     "inputs": [{"name": "in", "unit": "audio"}, {"name": "time", "unit": "V/oct"}],
     "outputs": [{"name": "l", "unit": "audio"}, {"name": "r", "unit": "audio"}],
     "params": [{"name": "time", "min": 0.02, "max": 1, "default": 0.34999999999999998, "unit": "s"},
                 {"name": "feedback", "min": 0, "max": 0.90000000000000002, "default": 0.34999999999999998, "unit": "x"},
                 {"name": "mix", "min": 0, "max": 1, "default": 0.29999999999999999, "unit": "x"},
                 {"name": "tone", "min": 200, "max": 12000, "default": 3500, "unit": "Hz"}],
     "note": "our addition (PATCH-3): a ping-pong delay; 1 V on time doubles it"},
    {"type": "out",
     "inputs": [{"name": "l", "unit": "audio"}, {"name": "r", "unit": "audio"}],
     "outputs": [],
     "params": [{"name": "level", "min": 0, "max": 1, "default": 0.5, "unit": "x"}],
     "note": "to the master bus and the safety chain; r unpatched follows l"},
    {"type": "reverb",
     "inputs": [{"name": "in", "unit": "audio"}],
     "outputs": [{"name": "l", "unit": "audio"}, {"name": "r", "unit": "audio"}],
     "params": [{"name": "t60", "min": 0.10000000000000001, "max": 10, "default": 2, "unit": "s"},
                 {"name": "size", "min": 0.5, "max": 1.5, "default": 1, "unit": "x"},
                 {"name": "tone", "min": 500, "max": 16000, "default": 6000, "unit": "Hz"},
                 {"name": "mix", "min": 0, "max": 1, "default": 0.29999999999999999, "unit": "x"}],
     "note": "our addition (PATCH-3): a 4-line feedback delay network; -60 dB in t60"}
  ]
}
